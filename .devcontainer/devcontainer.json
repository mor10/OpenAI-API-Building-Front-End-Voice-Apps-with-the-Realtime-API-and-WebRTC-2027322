{
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md"
      ]
    },
    "vscode": {
      // Set *default* container specific settings.json values on container create.
      "settings": {
        "terminal.integrated.shell.linux": "/bin/bash"
      },
      // Add the IDs of extensions you want installed when the container is created.
      "extensions": [
        "linkedinlearning.linkedinlearning-vscode-theme",
        "ritwickdey.LiveServer"
      ]
    }
  },
  // Update welcome text and set terminal prompt to '$ '
  "onCreateCommand": "echo PS1='\"$ \"' >> ~/.bashrc",
  // Install dependencies for the auth-server
  "postCreateCommand": "cd auth-server && npm install && curl -LsSf https://astral.sh/uv/install.sh | sh",
  // Forward port for the auth-server and make it public
  "forwardPorts": [
    3000,
    5500,
    8000
  ],
  "portsAttributes": {
    "3000": {
      "label": "auth-server"
    },
    "5500": {
      "label": "Live Server"
    },
    "8000": {
      "label": "MCP Server"
    }
  }
}
// DevContainer Reference: https://code.visualstudio.com/docs/remote/devcontainerjson-reference